use strict;
use warnings;
use Test::More;
use FindBin;
use lib "$FindBin::Bin/../lib";
use Tk;
use SuperSpinbox;
my $window=MainWindow->new;
my ($number,$callbacks)=(12.3456,0);
my $control=SuperSpinbox->new(parent=>$window, variable=>\$number, places=>4, min=>-1000,max=>1000,command=>sub{$callbacks++});
$control->widget->pack; $window->update;
is(join('', map {$_->cget('-text')} @{$control->{digits}}),'00123456','real Tk digits initialise from shared scalar');
$control->{up}{1}->invoke;
is($number,22.3456,'real tens button updates original scalar');
is($callbacks,1,'one callback per change');
$number=9.9999; $window->update;
is(join('', map {$_->cget('-text')} @{$control->{digits}}),'00099999','external scalar assignment refreshes all digits');
is($callbacks,1,'external refresh does not trigger rendering');
$control->{up}{-4}->invoke; is($number,10,'real Tk carry updates bound scalar');
$control->set(1000); my $at_limit=$callbacks;
$control->{up}{0}->invoke; is($callbacks,$at_limit,'no rendering callback at unchanged bound');
$control->{typed}='not a number'; $control->{entry}->eventGenerate('<Return>'); $window->update;
is($number,1000,'invalid typed input never reaches synthesizer');
$control->set('1.25'); is($number,1.25,'typing a whole value also supported');
$control->{sign}->invoke; is($number,-1.25,'explicit sign button');
$control->widget->destroy; $number=2;
is($number,2,'destroy cleans up trace without breaking voice scalar');
$window->destroy;
done_testing;
