use strict;
use warnings;
use Test::More;
use FindBin;
use lib "$FindBin::Bin/../lib";
use SuperSpinbox;
use Tk;
my $window=MainWindow->new;
my ($number,$callbacks)=(12.3456,0);
my $control=SuperSpinbox->new(parent=>$window, variable=>\$number, places=>4, min=>-1000,max=>1000,command=>sub{$callbacks++});
$control->widget->pack; $window->update;
my $tens=$control->{digits}{1};
isa_ok($tens,'Tk::Spinbox');
is($tens->get,1,'tens digit shown');
my $normal = $tens->cget('-foreground');
my $muted = $control->{digits}{2}->cget('-foreground');
isnt($muted,$normal,'leading hundreds zero is subdued');
$tens->invoke('buttonup');
is($number,22.3456,'native tens arrow updates original scalar');
is($callbacks,1,'one callback per change');
$number=9.9999; $window->update;
is($control->{digits}{0}->get,9,'external scalar refreshes units');
is($callbacks,1,'external refresh does not trigger rendering');
$control->{digits}{-4}->invoke('buttonup'); is($number,10,'carry across decimal');
is($tens->cget('-foreground'),$normal,'carry makes tens significant');
is($control->{digits}{0}->cget('-foreground'),$muted,'trailing integer zero dims');
is($control->{digits}{-4}->cget('-foreground'),$muted,'trailing fractional zeros dim');
$control->{digits}{-4}->invoke('buttondown'); is($number,9.9999,'borrow across decimal');
is($tens->cget('-foreground'),$muted,'borrow dims tens again');
$control->set(1000); my $at_limit=$callbacks;
$control->{digits}{0}->invoke('buttonup'); is($callbacks,$at_limit,'no callback at bound');
$tens->focusForce; $window->update;
$tens->eventGenerate('<F2>'); $window->update;
ok($control->{entry}->ismapped,'whole-value editor appears in place');
$control->{typed}='not a number'; $control->{entry}->eventGenerate('<Return>'); $window->update;
is($number,1000,'invalid text never reaches synth');
$control->{typed}='1.25'; $control->{entry}->eventGenerate('<Return>'); $window->update;
is($number,1.25,'whole value committed');
ok(!$control->{entry}->ismapped,'digit row restored');
$control->{sign}->invoke('buttondown'); is($number,-1.25,'native sign control');
$tens->invoke('buttonup'); is($number,8.75,'up increases negative values');
$control->set(10.02);
is($control->{digits}{-1}->cget('-foreground'),$normal,'zero between nonzero digits stays bright');
is($control->{digits}{-3}->cget('-buttonuprelief'),'flat','trailing zero button is subdued');
$control->set(0);
is($control->{digits}{0}->cget('-foreground'),$normal,'zero retains a visible units digit');
$control->widget->destroy; $number=2;
is($number,2,'destroy releases bound scalar');
$window->destroy;
done_testing;
