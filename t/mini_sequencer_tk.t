use strict;
use warnings;
use Test::More;
use FindBin;
use lib "$FindBin::Bin/../lib";
use Tk;
use MiniSequencer::Tk;
my $window=MainWindow->new;
my (@played,$stops);
my $seq=MiniSequencer::Tk->new(parent=>$window,play=>sub{push @played,$_[0]},stop=>sub{$stops++},rng=>sub{0});
$seq->widget->pack; $window->update;
is($seq->{running},0,'creating the UI does not start playback');
is(scalar @played,0,'no audio callback until explicit user action');
$seq->{randomise}->invoke;
is($seq->{running},1,'Randomise & Play starts transport');
is(scalar @played,1,'first note starts immediately');
my $token=$seq->{token};
$seq->{randomise}->invoke;
is(scalar @played,2,'next click auditions a fresh pattern immediately');
$seq->_tick($token); is(scalar @played,2,'stale callback cannot start an overlapping loop');
$seq->{stop_button}->invoke; is($seq->{running},0,'Stop stops transport');
ok(!exists $seq->{timer},'Stop cancels pending clock');
my $after=scalar @played; $seq->_tick($seq->{token}); is(scalar @played,$after,'stopped ticks cannot play');
$seq->{tempo}='bad'; $seq->start; is($seq->{running},0,'invalid typed tempo does not start');
like($seq->{status},qr/40 to 240/,'clear tempo error');
$seq->{tempo}=240; $seq->start;
# Advance an actual Tk timer, not a simulated playback thread.
my $done=0; $window->after(150,sub{$done=1});
$window->DoOneEvent(0) until $done;
cmp_ok($seq->{current},'>=',2,'Tk clock advances through sixteenth-note steps');
$seq->stop;
$seq->{model}{steps}[1]=0; # make the next timed step audible for the register check
my $original_steps=$seq->{model}->steps;
is($seq->{octave},3,'sequencer starts in octave 3');
$seq->{octave_up}->invoke;
is($seq->{octave},4,'octave up button updates selected register');
like($seq->{buttons}[0]->cget('-text'),qr/C4/,'step labels reflect octave up');
$seq->start;my $up_note=$played[-1];my $clock_token=$seq->{token};
$seq->{octave_down}->invoke;
is($seq->{token},$clock_token,'octave change does not restart or duplicate the clock');
my $wait=0;$window->after(80,sub{$wait=1});$window->DoOneEvent(0) until $wait;
cmp_ok(abs($up_note/$played[-1]-2),'<',0.000001,'next playing step drops exactly one octave');
$seq->stop;
is_deeply($seq->{model}->steps,$original_steps,'octave changes keep the same notes and rests');
$seq->shift_octave(-1) for 1..12;
is($seq->{octave},0,'lower octave bound enforced');
is($seq->{octave_down}->cget('-state'),'disabled','down control disabled at lower bound');
$seq->shift_octave(1) for 1..12;
is($seq->{octave},7,'upper octave bound enforced');
is($seq->{octave_up}->cget('-state'),'disabled','up control disabled at upper bound');
ok(!eval{MiniSequencer::Tk->new(parent=>$window,play=>sub{},stop=>sub{},octave=>8);1},'invalid initial octave rejected');
my $broken=MiniSequencer::Tk->new(parent=>$window,play=>sub{die 'device unavailable'},stop=>sub{});
$broken->start; is($broken->{running},0,'playback failure stops transport');
like($broken->{status},qr/device unavailable/,'playback failure shown');
$seq->start; $seq->widget->destroy;
ok(!$seq->{running} && !exists $seq->{timer},'destroy cleans up timer and held note');
$window->destroy;
done_testing;
