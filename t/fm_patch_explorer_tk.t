use strict;
use warnings;
use Test::More;
use FindBin;
use lib "$FindBin::Bin/..", "$FindBin::Bin/../lib";
use Tk;
use Patch;
use Voice;
use FMPatchExplorer::Tk;
my $window=MainWindow->new;
my $patch=Patch->new(name=>'Fictional test patch',length=>1,voices=>[Voice->new]);
my $manager=FMPatchExplorer->new(rng=>sub{0.5});
my ($previews,$stop_calls,$recoveries,$fail,$reentered)=(0,0,0,0,0);
my $ui;
$ui=FMPatchExplorer::Tk->new(parent=>$window,manager=>$manager,patch=>sub{$patch},
 before=>sub{$stop_calls++},preview=>sub{
   $previews++; $reentered++ unless $ui->run('variation');
   die 'fixture device failure' if $fail;
 },recover=>sub{$recoveries++});
$ui->widget->pack; $window->update;
my $original=$manager->snapshot($patch);
is($previews,0,'opening explorer does not change or play a patch');
$ui->{buttons}{new_sound}->invoke;
is($previews,1,'New sound auditions exactly once');
is($reentered,1,'nested events cannot generate concurrent sounds');
isnt($patch->voices->[0]->modulators,undef,'New sound creates an FM operator');
is($ui->{buttons}{undo}->cget('-state'),'normal','Undo becomes available');
$ui->{buttons}{keep}->invoke;
is($previews,1,'Like this does not rerender or play');
my $keeper=$manager->snapshot($patch);
$ui->{buttons}{variation}->invoke;
is($previews,2,'Variation auditions once');
is($patch->voices->[0]->modulators->[0]->freq_multiplier,$keeper->{voices}[0]{modulators}[0]{freq_multiplier},'UI variation preserves ratio');
$ui->{buttons}{undo}->invoke;
is_deeply($manager->snapshot($patch),$keeper,'real Undo button restores keeper');
$fail=1;my $before=$manager->snapshot($patch);my $depth=$manager->can_undo($patch);
$ui->{buttons}{new_sound}->invoke;
is_deeply($manager->snapshot($patch),$before,'failure leaves previous patch intact');
is($manager->can_undo($patch),$depth,'failure preserves undo depth');
like($ui->{status},qr/Sound unchanged:.*fixture device failure/s,'error clearly reported');
is($recoveries,1,'GUI recovery hook invoked');
is($ui->{buttons}{new_sound}->cget('-state'),'normal','controls restore after failure');
$fail=0; $ui->{buttons}{variation}->invoke;
like($ui->{status},qr/Gentle variation/,'retry works');
$window->destroy;
done_testing;
